# ==============================================================================
# KTHW UPGRADE — Target versions
#
# Source this file before running any upgrade script to set the target versions:
#   source scripts/14-upgrade/versions.env
#
# Or pass versions inline:
#   KUBERNETES_VERSION=v1.33.1 ./scripts/14-upgrade/02-upgrade-control-plane.sh
#
# Compatibility rules:
#   - Upgrade one minor version at a time (1.32 → 1.33, never 1.32 → 1.34)
#   - crictl minor version must match Kubernetes minor version
#   - kube-apiserver must always be >= all other control plane components
#   - containerd must meet the minimum version for the target Kubernetes release
#     see: https://kubernetes.io/docs/setup/production-environment/container-runtimes/
# ==============================================================================

export KUBERNETES_VERSION="v1.33.1"
export CRICTL_VERSION="v1.33.0"
export CNI_PLUGINS_VERSION="v1.6.2"
export CONTAINERD_VERSION="2.1.7"
export ETCD_VERSION="v3.6.11"
